{
  "name": "tether",
  "version": "1.0.0",
  "private": true,
  "description": "Tether — real-time chat app",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c teal,magenta \"pnpm --dir backend dev\" \"pnpm --dir frontend dev\"",
    "dev:backend": "pnpm --dir backend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "start": "pnpm --dir backend start",
    "lint": "pnpm --dir frontend lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
